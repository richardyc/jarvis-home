# Copy to `secrets.properties` and fill in. That file is gitignored — never commit it.
# The values are injected as BuildConfig fields at compile time (see app/build.gradle.kts).

# Required. Needs Realtime API access. https://platform.openai.com/api-keys
openai.api.key=

# Optional. Only used by the vision/image path; leave blank to disable.
# https://openrouter.ai/keys
openrouter.api.key=
